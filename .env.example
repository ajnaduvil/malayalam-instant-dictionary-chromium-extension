# Mozilla AMO API (JWT) — https://addons.mozilla.org/developers/addon/api/key/
# Copy to .env and fill in. Used by npm run package for web-ext sign.
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=

# listed | unlisted (web-ext sign requires a channel; default in script is unlisted)
# Use `npm run package:firefox-listed` for a public-store build without editing .env.
# WEB_EXT_CHANNEL=unlisted

# Optional: override gecko id in manifest only for the Firefox staging copy
# FIREFOX_GECKO_ADDON_ID=your-id@yourdomain

# Optional: scripts/sync-amo-listing.mjs (PATCH listing on AMO)
# AMO_ADDON_GUID=malayalam-instant-dictionary@extension.local
# AMO_CHROME_STORE_URL=https://chromewebstore.google.com/detail/...
# AMO_LISTING_LOCALE=en-US
# AMO_DRY_RUN=1
# AMO_ICON_PATH=icons/icon128.png
